# /opt/coo/.env on the server (mode 600). Never in the repo, never in an image.
# deploy-prod.sh creates it on the first deploy, with a password generated on the server that is never printed.
POSTGRES_PASSWORD=

# Sign-in (Spec 010 §4.3). deploy-prod.sh adds both when they are missing.
# The Google Cloud "Web application" client of project coo-app-510411 (docs/google-sign-in-setup.md §6). Not a secret.
AUTH_GOOGLE_WEB_CLIENT_ID=
# The access-token signing key, 32 random bytes in base64: openssl rand -base64 32. Generated on the server, never printed.
AUTH_SIGNING_KEY_K1=

# App Links (Spec 011b §4.2). deploy-prod.sh adds it when missing. The SHA-256 of the key that signs the installed APK:
# the debug key until Increment 18 (keytool -list -v, DEPLOY.md "App Links"). Not a secret.
APPLINKS_SHA256_DEBUG=

# Invitation codes (Spec 011b §10.3). deploy-prod.sh adds it when missing. The pepper of the codes' stored hashes, 32 random
# bytes in base64: openssl rand -base64 32. Generated on the server, never printed. Changing it invalidates open invitations.
INVITATIONS_CODE_PEPPER=
