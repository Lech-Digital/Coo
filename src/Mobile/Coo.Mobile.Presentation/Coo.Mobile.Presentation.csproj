<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- MVVMTK0045 asks for partial properties for WinRT AOT; it does not apply to Android, and partial-property
         generation needs LangVersion preview with CommunityToolkit.Mvvm 8.4. Field-based [ObservableProperty] is used. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by eng/strings/generate.py (ADR 0006 §2). Satellite assemblies carry the six translations. -->
    <EmbeddedResource Update="Resources\AppResources*.resx" />
    <EmbeddedResource Include="Advisor\Content\*.json" LogicalName="Advisor.Content.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Coo.Mobile.Application/Coo.Mobile.Application.csproj" />
  </ItemGroup>

</Project>
