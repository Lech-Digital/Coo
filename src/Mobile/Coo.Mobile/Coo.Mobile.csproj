<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-targets Android (ADR 0001 §3). Never multi-target and never pass
         -p:TargetFrameworks=...: see BUILD.md for the NETSDK1147 / NETSDK1005 traps. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Coo.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Mochi</ApplicationTitle>
    <ApplicationId>com.lechdigital.coo</ApplicationId>
    <ApplicationDisplayVersion>1.12.0</ApplicationDisplayVersion>
    <!-- Every build that leaves this machine bumps both (CHANGELOG.md): the name by SemVer, the code by one, never reused. -->
    <ApplicationVersion>32</ApplicationVersion>
    <!-- The informational version is the display version plus the commit, e.g. 0.13.0+<commit> (SourceLink), shown in About like the API's /health. -->
    <Version>$(ApplicationDisplayVersion)</Version>

    <!-- Android 8.0: notification channels always exist (Spec 002 §3.1, ADR 0007). -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <!-- CA1859: UI trees are built in C# by methods that deliberately return View, so a page can swap what it shows. -->
    <NoWarn>$(NoWarn);CA1859</NoWarn>
  </PropertyGroup>

  <!-- The demo build for store screenshots (store-assets/PLAN.md §1): its own app, filled with a made-up baby on first
       launch. Never uploaded, never on the owner's real install. -->
  <PropertyGroup Condition="'$(CooDemo)' == 'true'">
    <ApplicationId>com.lechdigital.coo.demo</ApplicationId>
    <DefineConstants>$(DefineConstants);COO_DEMO</DefineConstants>
  </PropertyGroup>

  <!-- The debug screen (Spec 004 §8): in Debug builds, and in a Release build only when asked for with
       -p:CooDebugScreen=true, for the trimmed-build check on a phone. Never in a store build. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(CooDebugScreen)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG_SCREEN</DefineConstants>
    <CooIncludeDebugScreen>true</CooIncludeDebugScreen>
  </PropertyGroup>

  <!-- R8 shrinks and obfuscates the Java side in store builds (Play's DEX optimisation check, 2026-11-03). Its mapping
       goes into the AAB's metadata, so Play retraces crash reports. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
  </ItemGroup>
  <ItemGroup Condition="'$(CooIncludeDebugScreen)' != 'true'">
    <Compile Remove="DebugScreen/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon D2, "saying coo" (store-assets/icon-options): a baby in a speech bubble on peach. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#8DB462" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#EEEEE6" BaseSize="128,128" />
    <!-- Figtree only (design system §3). eng/verify-apk-fonts.sh checks they reach the APK. -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <!-- Tab icons, from the same 24-grid paths as the Icon control (design system §5). -->
    <MauiImage Include="Resources\Images\tab_*.svg" BaseSize="24,24" />
    <!-- Avatar illustration presets: sharp high-resolution rendering -->
    <MauiImage Include="Resources\Images\avatar_*.svg" BaseSize="256,256" />
    <!-- Mochi awake and asleep (ADR 0011): beside the hero on Today (64 dp) and in the widget (36 dp). -->
    <MauiImage Include="Resources\Images\mochi_*.svg" BaseSize="96,96" />
    <!-- The licence texts (Spec 009 §3.6), read with FileSystem.OpenAppPackageFileAsync("licences/…"). -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" />
    <PackageReference Include="Xamarin.Google.Android.Play.Review" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Plugin.InAppBilling" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Coo.Mobile.Presentation/Coo.Mobile.Presentation.csproj" />
    <ProjectReference Include="../Coo.Mobile.Infrastructure/Coo.Mobile.Infrastructure.csproj" />
    <ProjectReference Include="../Coo.Mobile.Platform/Coo.Mobile.Platform.csproj" />
  </ItemGroup>

</Project>
