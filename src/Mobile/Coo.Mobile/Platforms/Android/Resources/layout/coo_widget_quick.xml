<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log: six buttons that log at once, without opening Coo. What each does follows what is running (a feed gives
     Switch, Pause and Stop). Only views RemoteViews allows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/quick_title"
        android:text="Lena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_1"
            android:text="Left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_feed"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_feed_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_2"
            android:text="Right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_feed"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_feed_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_3"
            android:text="Sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_feed"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_feed_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_4"
            android:text="Wet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_feed"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_feed_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_5"
            android:text="Dirty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_feed"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_feed_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_6"
            android:text="Pump"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_feed"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_feed_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
