<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- allowBackup is off: care data is health data about a child, and must not be extractable
       through adb backup or auto-synced off the device. Backup is a deliberate feature (ADR 0003). -->
  <application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
  <!-- Android 11+ hides other apps unless declared: "Send feedback" needs to see a mail app (Spec 009 §3.6). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="mailto" />
    </intent>
    <!-- A health record from a photo: the camera app that takes it. -->
    <intent>
      <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
    <!-- Voice logging (ADR 0005 §2) needs to see the speech recogniser. -->
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
  </queries>
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Voice logging only, asked for on first use (ADR 0005 §2). Audio stays with Android's recogniser. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- A health record from a photo, asked for when "Take a photo" is first tapped. The photo is read, never kept. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Reminders (ADR 0007): asked for when the first reminder is turned on; alarms come back after a reboot. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Reminders on the minute (ADR 0007 §3), only when the parent allows "Alarms & reminders" for Coo in Android's
       settings; without it they stay inexact. Not USE_EXACT_ALARM: that one is for alarm-clock and calendar apps. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
