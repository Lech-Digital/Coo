<?xml version="1.0" encoding="utf-8" ?>
<!--
  Type styles and control styles (design system §3, §6; Spec 005 §4.3).
  Tracking: the design system gives it in px at each style's size (from the CSS mockup). MAUI's CharacterSpacing is
  not px: Android applies it as 0.0624 em per unit. So the value here is px / size / 0.0624; for example the timer's
  −3 px at 88 sp is −0.55. Using −3 directly made the timer digits overlap on the phone. Colours are always DynamicResource,
  so a palette swap restyles everything without a restart. Number styles (Timer, Hero, Window) get the
  "Tabular" style class in code (Ui.Text), because the XAML source generator cannot set StyleClass in a Setter.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Body is the implicit label style. -->
  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeRegular" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>

  <Style x:Key="Timer" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeLight" />
    <Setter Property="FontSize" Value="88" />
    <Setter Property="CharacterSpacing" Value="-0.55" />
    <Setter Property="FontAutoScalingEnabled" Value="False" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Hero" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeLight" />
    <Setter Property="FontSize" Value="64" />
    <Setter Property="CharacterSpacing" Value="-0.63" />
    <Setter Property="FontAutoScalingEnabled" Value="False" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Window" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeMedium" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="CharacterSpacing" Value="-0.4" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Title" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="CharacterSpacing" Value="-0.34" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Section" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="CharacterSpacing" Value="-0.24" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Body" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeRegular" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="BodyStrong" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeMedium" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Meta" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeRegular" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextColor" Value="{DynamicResource Ink2}" />
  </Style>
  <!-- The eyebrow. Upper-casing is done per culture in code (Spec 005 §4.3), never in the strings. -->
  <Style x:Key="Label" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CharacterSpacing" Value="1.6" />
    <Setter Property="TextColor" Value="{DynamicResource Ink2}" />
  </Style>
  <Style x:Key="Tile" TargetType="Label">
    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Buttons (design system §6): pill, at least 48 dp, one primary per screen. -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
    <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinimumHeightRequest" Value="48" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="BorderWidth" Value="0" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    <Setter Property="BorderColor" Value="{DynamicResource Line}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinimumHeightRequest" Value="48" />
    <Setter Property="Padding" Value="24,0" />
  </Style>
  <Style x:Key="NightPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="MinimumHeightRequest" Value="64" />
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style x:Key="NightGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="MinimumHeightRequest" Value="64" />
    <Setter Property="FontSize" Value="17" />
  </Style>

  <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{DynamicResource Ground}" />
  </Style>
</ResourceDictionary>
