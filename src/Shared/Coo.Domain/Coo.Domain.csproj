    <InternalsVisibleTo Include="Coo.Api.Application" />
    <InternalsVisibleTo Include="Coo.Api.Infrastructure" />
    <InternalsVisibleTo Include="Coo.Mobile.Application" />
    <InternalsVisibleTo Include="Coo.Mobile.Infrastructure" />
    <InternalsVisibleTo Include="Coo.Domain.Tests" />
    <InternalsVisibleTo Include="Coo.Codecs.Tests" />
    <InternalsVisibleTo Include="Coo.Api.Application.Tests" />
    <InternalsVisibleTo Include="Coo.Api.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Coo.Mobile.Application.Tests" />
    <InternalsVisibleTo Include="Coo.Mobile.Infrastructure.Tests" />
  </ItemGroup>

</Project>
