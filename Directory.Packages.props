<Project>
  <!-- Central package management (Spec 002 §4.3). Add a package only when code uses it. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build-time guards -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

    <!-- Runtime -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- Matches the installed maui-android workload (10.0.0); see BUILD.md. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Pinned below 8: FluentAssertions 8+ is under a commercial licence. -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2, 8.0.0)" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
