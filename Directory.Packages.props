<Project>
  <!-- Central package management (Spec 002 §4.3). Add a package only when code uses it. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build-time guards -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

    <!-- Runtime -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- Matches the installed maui-android workload (10.0.0); see BUILD.md. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Phone storage: plain SQLite, no ORM (Spec 004 §13). The bundle ships its own SQLite with JSON built in. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <!-- Sign in with Google (Spec 010a §5): exactly these. Newer ones pull AndroidX libraries newer than MAUI 10.0.0 pins
         (NU1608) or need a newer GoogleId (NU1605), errors here. Revisit with the next MAUI upgrade. -->
    <PackageVersion Include="Xamarin.AndroidX.Credentials" Version="1.5.0" />
    <PackageVersion Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.5.0" />
    <PackageVersion Include="Xamarin.GoogleAndroid.Libraries.Identity.GoogleId" Version="1.1.0.8" />
    <!-- Server storage: PostgreSQL through EF Core, schema by migrations (ADR 0001 §4, Spec 008 §4). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- Pinned so the whole backend runs one EF Core patch (Npgsql alone would bring 10.0.4). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!-- Users without passwords (ADR 0003 §3, Spec 010 §4.2). Same patch as EF Core and Mvc.Testing. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!-- Sign-in (Spec 010 §4): our own JWTs, and Google ID token verification with cached Google keys (ADR 0003 §5). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.77.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Pinned below 8: FluentAssertions 8+ is under a commercial licence. -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2, 8.0.0)" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Real PostgreSQL 17 in Docker for the server tests (ADR 0010 G6, Spec 008 §9). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
</Project>
